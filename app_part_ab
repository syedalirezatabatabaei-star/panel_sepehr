// PAGE: User Management
// ═══════════════════════════════════════════════════════════════════
function renderUsers() {
  let filtered = [...USERS];
  
  // Search
  if (AppState.userSearch) {
    const q = AppState.userSearch.toLowerCase();
    filtered = filtered.filter(u => 
      u.firstName.includes(q) || u.lastName.includes(q) || 
      u.username.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)
    );
  }
  
  // Filter
  if (AppState.userFilter === 'active') filtered = filtered.filter(u => u.status === 'active');
  else if (AppState.userFilter === 'inactive') filtered = filtered.filter(u => u.status === 'inactive');
  else if (AppState.userFilter === 'level-3') filtered = filtered.filter(u => u.level === 3);
  else if (AppState.userFilter === 'level-2') filtered = filtered.filter(u => u.level === 2);
  else if (AppState.userFilter === 'level-1') filtered = filtered.filter(u => u.level === 1);

  const totalPages = Math.ceil(filtered.length / AppState.usersPerPage);
  const start = (AppState.currentPageUsers - 1) * AppState.usersPerPage;
  const pageUsers = filtered.slice(start, start + AppState.usersPerPage);

  return `
    <div class="page-header">
      <div class="breadcrumb">
        <a href="#" onclick="navigateTo('overview'); return false;">تنظیمات</a>
        <span class="separator">/</span>
        <span class="current">مدیریت کاربران</span>
      </div>
      <h1>مدیریت کاربران</h1>
      <p>مشاهده، ویرایش و مدیریت دسترسی کاربران سیستم</p>
    </div>
    
    <div class="toolbar">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="جستجوی کاربر..." value="${AppState.userSearch}" 
          oninput="AppState.userSearch = this.value; AppState.currentPageUsers = 1; navigateTo('users')">
      </div>
      <button class="filter-btn ${AppState.userFilter === 'all' ? 'active' : ''}" onclick="AppState.userFilter='all'; AppState.currentPageUsers=1; navigateTo('users')">همه</button>
      <button class="filter-btn ${AppState.userFilter === 'active' ? 'active' : ''}" onclick="AppState.userFilter='active'; AppState.currentPageUsers=1; navigateTo('users')">فعال</button>
      <button class="filter-btn ${AppState.userFilter === 'inactive' ? 'active' : ''}" onclick="AppState.userFilter='inactive'; AppState.currentPageUsers=1; navigateTo('users')">غیرفعال</button>
      <button class="filter-btn ${AppState.userFilter === 'level-3' ? 'active' : ''}" onclick="AppState.userFilter='level-3'; AppState.currentPageUsers=1; navigateTo('users')">سطح ۳</button>
      <button class="filter-btn ${AppState.userFilter === 'level-2' ? 'active' : ''}" onclick="AppState.userFilter='level-2'; AppState.currentPageUsers=1; navigateTo('users')">سطح ۲</button>
      <button class="filter-btn ${AppState.userFilter === 'level-1' ? 'active' : ''}" onclick="AppState.userFilter='level-1'; AppState.currentPageUsers=1; navigateTo('users')">سطح ۱</button>
      <button class="btn btn-primary" onclick="showCreateUserModal()">+ کاربر جدید</button>
    </div>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>کاربر</th>
            <th>وضعیت</th>
            <th>سطح</th>
            <th>نقش</th>
            <th>آخرین ورود</th>
            <th>Permissionها</th>
            <th>عملیات</th>
          </tr>
        </thead>
        <tbody>
          ${pageUsers.map(user => {
            const role = ROLES.find(r => r.id === user.role);
            const perms = getEffectivePermissions(user.id);
            return `
              <tr>
                <td>
                  <div class="user-cell">
                    ${renderAvatar(user, 'md')}
                    <div>
                      <div class="user-name">${user.firstName} ${user.lastName}</div>
                      <div class="user-username">@${user.username}</div>
                    </div>
                  </div>
                </td>
                <td>${statusBadge(user.status)}</td>
                <td>${levelBadge(user.level)}</td>
                <td><span class="badge badge-primary">${role ? role.name : user.role}</span></td>
                <td><span style="font-size: var(--font-size-xs); color: var(--gray-500)">${user.lastLogin}</span></td>
                <td><span class="badge badge-gray">${perms.length} دسترسی</span></td>
                <td>
                  <div class="actions-cell">
                    <button class="btn btn-ghost btn-icon sm" title="مشاهده" onclick="navigateTo('user-details', {userId: ${user.id}})">👁️</button>
                    <button class="btn btn-ghost btn-icon sm" title="ویرایش" onclick="navigateTo('edit-user', {userId: ${user.id}})">✏️</button>
                    <button class="btn btn-ghost btn-icon sm" title="مدیریت دسترسی‌ها" onclick="navigateTo('user-permissions', {userId: ${user.id}})">🔑</button>
                    <button class="btn btn-ghost btn-icon sm" title="${user.status === 'active' ? 'غیرفعال کردن' : 'فعال کردن'}" onclick="toggleUserStatus(${user.id})">${user.status === 'active' ? '🔴' : '🟢'}</button>
                    <button class="btn btn-ghost btn-icon sm" title="بازنشانی رمز" onclick="showResetPasswordModal(${user.id})">🔑</button>
                  </div>
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <div class="pagination-info">نمایش ${start + 1}-${Math.min(start + AppState.usersPerPage, filtered.length)} از ${filtered.length} کاربر</div>
      ${renderPagination(AppState.currentPageUsers, totalPages, 'goToUsersPage')}
    </div>
  `;
}

function goToUsersPage(page) {
  const totalPages = Math.ceil(USERS.length / AppState.usersPerPage);
  if (page >= 1 && page <= totalPages) {
    AppState.currentPageUsers = page;
    navigateTo('users');
  }
}

