# Copy to .env on the server only; never commit real credentials.
# Use the CURRENT database password from the existing deployment.
DB_HOST=mysql
DB_USER=bale_api
DB_PASSWORD=REPLACE_WITH_CURRENT_DATABASE_PASSWORD
DB_NAME=bale_sender
DB_CONNECT_TIMEOUT=10

# Browser origin serving the frontend. Add your HTTPS domain when configured.
FRONTEND_ORIGINS=http://95.38.187.123:3002
# Set true only after the browser accesses the site through HTTPS.
COOKIE_SECURE=false

# Keep current endpoints until the chat services are moved onto internal Docker DNS.
BALE_CHAT_SERVICE_URL=http://95.38.187.123:3000
EITAA_CHAT_SERVICE_URL=http://95.38.187.123:3001

BALE_SEND_WEBHOOK_URL=https://n8n.sepehrsalamati.ir/webhook/seandms
BALE_CREATE_CHAT_WEBHOOK_URL=https://n8n.sepehrsalamati.ir/webhook/plasuser
EITAA_SEND_WEBHOOK_URL=https://n8n.sepehrsalamati.ir/webhook/
