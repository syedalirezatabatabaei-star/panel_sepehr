// ─── Navigation ────────────────────────────────────────────────────
function navigateTo(page, data) {
  AppState.currentPage = page;
  closeSettingsNav();
  if (data) {
    if (data.userId !== undefined) AppState.selectedUserId = data.userId;
    if (data.roleId !== undefined) AppState.selectedRoleId = data.roleId;
  }
  
  // Update settings nav
  document.querySelectorAll('.settings-nav-item').forEach(el => {
    el.classList.toggle('active', el.dataset.page === page || 
      (page === 'user-permissions' && el.dataset.page === 'users') ||
      (page === 'role-permissions' && el.dataset.page === 'roles') ||
      (page === 'user-details' && el.dataset.page === 'users') ||
      (page === 'edit-user' && el.dataset.page === 'users')
