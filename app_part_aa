// ─── Helper: Avatar Colors ─────────────────────────────────────────
function avatarColor(id) {
  const colors = ['#2563eb', '#7c3aed', '#db2777', '#dc2626', '#ea580c', '#16a34a', '#0891b2', '#4f46e5'];
  return colors[id % colors.length];
}

function renderAvatar(user, size = 'md') {
  const initials = user.firstName.charAt(0) + ' ' + user.lastName.charAt(0);
  return `<div class="avatar ${size}" style="background: ${avatarColor(user.id)}">${initials}</div>`;
}

// ─── Helper: Status Badge ──────────────────────────────────────────
function statusBadge(status) {
  if (status === 'active') return '<span class="badge badge-success">فعال</span>';
  return '<span class="badge badge-danger">غیرفعال</span>';
}

function levelBadge(level) {
  const colors = { 1: 'badge-gray', 2: 'badge-info', 3: 'badge-danger' };
  return `<span class="badge ${colors[level] || 'badge-gray'}">سطح ${level}</span>`;
}

// ─── Helper: Pagination ────────────────────────────────────────────
function renderPagination(currentPage, totalPages, onPageChange) {
  if (totalPages <= 1) return '';
  let html = '<div class="pagination-btns">';
  html += `<button class="pagination-btn" onclick="${onPageChange}(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>›</button>`;
  for (let i = 1; i <= totalPages; i++) {
    if (totalPages > 7 && i > 2 && i < totalPages - 1 && Math.abs(i - currentPage) > 1) {
      if (i === 3 || i === totalPages - 2) html += '<span style="padding: 0 4px; color: var(--gray-400)">...</span>';
      continue;
    }
    html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" onclick="${onPageChange}(${i})">${i}</button>`;
  }
  html += `<button class="pagination-btn" onclick="${onPageChange}(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>‹</button>`;
  html += '</div>';
  return html;
}

