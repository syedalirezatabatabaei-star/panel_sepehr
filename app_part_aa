// ─── Load Current User From API ────────────────────────────────────
async function loadCurrentUser() {
  try {
    const response = await fetch(
      "http://95.38.187.123:8005/api/auth/me",
      {
        method: "GET",
        credentials: "include"
      }
    );
    const data = await response.json();
    console.log("ME API RESPONSE:", data);
    if (data.success) {
      CURRENT_USER = {
        id: data.user.id,
        firstName: data.user.first_name,
        lastName: data.user.last_name,
        username: data.user.username,
        level: data.user.access_level,
        status: data.user.is_active ? "active" : "inactive"
      };

      updateUserUI();
      console.log("CURRENT_USER LOADED:", CURRENT_USER);
    }
  } catch (error) {
    console.error("LOAD CURRENT USER ERROR:", error);
  }
}

// ─── Update UI with Current User Info ──────────────────────────────
function updateUserUI() {
  const fullName = `${CURRENT_USER.firstName} ${CURRENT_USER.lastName}`.trim();
  const username = CURRENT_USER.username;
  const level = CURRENT_USER.level;

  // Sidebar
  const sidebarName = document.querySelector('.sidebar-user .user-name');
  if (sidebarName) {
    sidebarName.textContent = fullName || username;
  }
  const sidebarRole = document.querySelector('.sidebar-user .user-role');
  if (sidebarRole) {
    sidebarRole.textContent = username.toUpperCase();
  }

  // Header
  const headerName = document.querySelector('.header-user .name');
  if (headerName) {
    headerName.textContent = fullName || username;
  }
  const headerRole = document.querySelector('.header-user .role-badge');
  if (headerRole) {
    headerRole.textContent = `${username} · سطح ${level}`;
  }

  // Avatar initials
  const initials = `${CURRENT_USER.firstName?.charAt(0) || ''} ${CURRENT_USER.lastName?.charAt(0) || ''}`.trim();
  document
    .querySelectorAll('.sidebar-user .avatar, .header-user .avatar')
    .forEach(avatar => {
      avatar.textContent = initials || 'کاربر';
    });

  console.log("CURRENT USER UI UPDATED:", {
    id: CURRENT_USER.id,
    name: fullName,
    username: username,
    level: level
  });
}

