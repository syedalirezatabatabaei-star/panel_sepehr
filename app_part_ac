// PAGE: User Permissions
// ═══════════════════════════════════════════════════════════════════
function renderUserPermissions() {
  const user = USERS.find(u => u.id === AppState.selectedUserId);
  if (!user) return '<div class="empty-state"><div class="icon">👤</div><div class="title">کاربر یافت نشد</div></div>';
  const role = ROLES.find(r => r.id === user.role);
  const permDetail = getEffectivePermissionsDetail(user.id);
  const permSearch = AppState.permSearch.toLowerCase();

  return `
    <div class="page-header">
      <div class="breadcrumb">
        <a href="#" onclick="navigateTo('overview'); return false;">تنظیمات</a>
        <span class="separator">/</span>
        <a href="#" onclick="navigateTo('users'); return false;">کاربران</a>
        <span class="separator">/</span>
        <a href="#" onclick="navigateTo('user-details', {userId: ${user.id}}); return false;">${user.firstName} ${user.lastName}</a>
        <span class="separator">/</span>
        <span class="current">مدیریت دسترسی‌ها</span>
      </div>
      <h1>مدیریت دسترسی کاربر</h1>
      <div style="display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-3);">
        ${renderAvatar(user, 'lg')}
        <div>
          <div style="font-size: var(--font-size-xl); font-weight: 700;">${user.firstName} ${user.lastName}</div>
          <div style="color: var(--gray-500);">@${user.username}</div>
        </div>
      </div>
    </div>

    <!-- Role Select -->
    <div class="card mb-6">
      <div class="card-header">
        <div class="card-title">سطح کلی کاربر</div>
      </div>
      <div style="display: flex; align-items: center; gap: var(--space-4);">
        <div class="form-group" style="margin: 0; flex: 1; max-width: 300px;">
          <select class="form-select" id="userRoleSelect" onchange="changeUserRole(${user.id}, this.value)">
            ${ROLES.map(r => `<option value="${r.id}" ${r.id === user.role ? 'selected' : ''}>${r.name} — ${r.label} (سطح ${r.level})</option>`).join('')}
          </select>
        </div>
        <div style="font-size: var(--font-size-sm); color: var(--gray-500);">
          تعداد Permission نقش: <strong>${role ? role.permissions.length : 0}</strong>
          &nbsp;|&nbsp;
          Permission اختصاصی: <strong>${permDetail.custom.length}</strong>
        </div>
      </div>
    </div>

    <!-- Search -->
    <div class="toolbar">
      <div class="search-box" style="max-width: 100%;">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="جستجوی Permission..." value="${AppState.permSearch}" 
          oninput="AppState.permSearch = this.value; navigateTo('user-permissions', {userId: ${user.id}})">
      </div>
      <button class="btn btn-secondary btn-sm" onclick="selectAllPerms(${user.id})">انتخاب همه</button>
      <button class="btn btn-secondary btn-sm" onclick="deselectAllPerms(${user.id})">حذف همه</button>
    </div>

    <!-- Permission Summary -->
    <div class="perm-summary">
      <div class="perm-summary-card">
        <div class="value" style="color: var(--primary)">${permDetail.role.length}</div>
        <div class="label">Permission نقش (${role ? role.name : '-'})</div>
      </div>
      <div class="perm-summary-card">
        <div class="value" style="color: var(--warning)">${permDetail.custom.length}</div>
        <div class="label">Permission اختصاصی</div>
      </div>
      <div class="perm-summary-card">
        <div class="value" style="color: var(--success)">${permDetail.effective.length}</div>
        <div class="label">Permission نهایی</div>
      </div>
    </div>

    <!-- Permission Groups -->
    <div id="permissionGroups">
      ${Object.entries(PERMISSION_GROUPS).map(([groupKey, group]) => {
        const groupPerms = PERMISSIONS.filter(p => p.group === groupKey);
        const filteredPerms = permSearch 
          ? groupPerms.filter(p => p.label.includes(permSearch) || p.id.includes(permSearch))
          : groupPerms;
        
        if (filteredPerms.length === 0) return '';
        const enabledCount = filteredPerms.filter(p => permDetail.effective.includes(p.id)).length;
        return `
          <div class="perm-group open">
            <div class="perm-group-header">
              <span class="perm-group-icon">${group.icon}</span>
              <span class="perm-group-title">${group.label}</span>
              <span class="perm-group-count">${enabledCount}/${filteredPerms.length}</span>
              <span class="perm-group-toggle">▼</span>
            </div>
            <div class="perm-group-body">
              ${filteredPerms.map(p => {
                const isRole = permDetail.role.includes(p.id);
                const isCustom = permDetail.custom.includes(p.id);
                const isEnabled = permDetail.effective.includes(p.id);
                return `
                  <div class="perm-item">
                    <div class="perm-item-info">
                      <label class="checkbox">
                        <input type="checkbox" ${isEnabled ? 'checked' : ''} 
                          onchange="toggleUserPermission(${user.id}, '${p.id}', this.checked)">
                        <span class="checkbox-mark"></span>
                      </label>
                      <div>
                        <div class="perm-item-label">${p.label}</div>
                        <div class="perm-item-id">${p.id}</div>
                      </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: var(--space-2);">
                      ${isRole ? '<span class="perm-item-source role">نقش</span>' : ''}
                      ${isCustom ? '<span class="perm-item-source custom">اختصاصی</span>' : ''}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('')}
    </div>
    <div class="mt-6" style="display: flex; gap: var(--space-3);">
      <button class="btn btn-primary" onclick="showToast('تغییرات ذخیره شد', 'success')">💾 ذخیره تغییرات</button>
      <button class="btn btn-secondary" onclick="navigateTo('user-details', {userId: ${user.id}})">انصراف</button>
    </div>
  `;
}

// ─── Permission Actions ────────────────────────────────────────────
function toggleUserPermission(userId, permId, checked) {
  const user = USERS.find(u => u.id === userId);
  if (!user) return;
  const idx = user.customPermissions.indexOf(permId);
  if (idx >= 0) {
    user.customPermissions.splice(idx, 1);
  } else {
    user.customPermissions.push(permId);
  }
}

function changeUserRole(userId, roleId) {
  const user = USERS.find(u => u.id === userId);
  if (!user) return;
  
  user.role = roleId;
  const newRole = ROLES.find(r => r.id === roleId);
  if (newRole) {
    user.level = newRole.level;
  }
  
  navigateTo('user-permissions', { userId: userId });
  if (typeof showToast === 'function') {
    showToast('نقش کاربر با موفقیت تغییر کرد', 'success');
  }
}
