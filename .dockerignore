# Git metadata and local secrets
.git/
**/.git/
.env
.env.*
!.env.example
.gitignore

# Python caches and virtual environments
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/.ruff_cache/

# Browser state and local runtime data
browser_profile/
browser_profile_backup_*/
data/eitaa-state/
data/eitaa-sessions/
data/eitaa-media/
data/state.db
reports/
logs/
*.log
build.log

# JavaScript/build caches
.npm/
.cache/

# The Eitaa service is fetched at its pinned commit in the Dockerfile
eitaa-service/

# Never bake local authentication artifacts into an image
cookies.txt
bale_session.json
