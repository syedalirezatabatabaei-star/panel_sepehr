import os
import shutil

from concurrent.futures import ThreadPoolExecutor

from playwright.sync_api import sync_playwright

from pages.bale_page import BalePage
from pages.login_page import LoginPage


# =========================================================
# PLAYWRIGHT SINGLE THREAD
# =========================================================

BALE_EXECUTOR = ThreadPoolExecutor(
    max_workers=1,
    thread_name_prefix="bale-playwright"
)


def run_bale(func, *args, **kwargs):

    future = BALE_EXECUTOR.submit(
        func,
        *args,
        **kwargs
    )

    return future.result()



# =========================================================
# PATHS
# =========================================================

BASE_DIR = os.path.dirname(
    os.path.abspath(__file__)
)


BROWSER_PROFILE = os.path.join(
    BASE_DIR,
    "browser_profile"
)


CHROMIUM_PATH = "/usr/bin/chromium"



# =========================================================
# BALE BACKEND
# =========================================================


class BaleBackend:


    def __init__(self):

        self.playwright = None

        self.context = None

        self.page = None


        self.bale = None

        self.login = None


        print(
            "[BALE] Backend initialized."
        )



    # =====================================================
    # CLEAR SESSION
    # =====================================================

    def clear_bale_session(self):

        if self.context is not None:

            raise RuntimeError(
                "Browser is running."
            )


        if os.path.exists(
            BROWSER_PROFILE
        ):

            shutil.rmtree(
                BROWSER_PROFILE
            )

            print(
                "[BALE] Old session removed."
            )


        os.makedirs(
            BROWSER_PROFILE,
            exist_ok=True
        )


        print(
            "[BALE] New session created."
        )



    # =====================================================
    # START BROWSER
    # =====================================================


    def start_browser(self):


        if self.context is not None:

            print(
                "[BALE] Browser already running."
            )

            return



        print(
            "[BALE] Starting Playwright..."
        )


        self.playwright = (
            sync_playwright()
            .start()
        )



        self.context = (
            self.playwright.chromium
            .launch_persistent_context(
                
                user_data_dir=BROWSER_PROFILE,

                executable_path=CHROMIUM_PATH,

                headless=True,

                args=[
                    "--no-sandbox",
                    "--disable-dev-shm-usage",
                    "--disable-gpu"
                ]
            )
        )



        if self.context.pages:

            self.page = (
                self.context.pages[0]
            )

        else:

            self.page = (
                self.context.new_page()
            )



        self.bale = BalePage(
            self.page
        )


        self.login = LoginPage(
            self.page
        )


        print(
            "[BALE] Browser started."
        )



    # =====================================================
    # OPEN BALE
    # =====================================================


    def open_bale(self):


        self.start_browser()


        self.bale.open_bale()


        print(
            "[BALE] Bale opened."
        )



    # =====================================================
    # AUTH
    # =====================================================


    def is_authenticated(self):


        if self.bale is None:

            return False


        try:

            return (
                self.bale
                .is_authenticated()
            )


        except Exception as e:


            print(
                "[BALE AUTH ERROR]",
                e
            )


            return False



    # =====================================================
    # LOGIN
    # =====================================================


    def start_login(
        self,
        phone: str
    ):


        phone = phone.strip()


        if not phone:

            raise ValueError(
                "Phone empty"
            )



        print(
            "[BALE] Login:",
            phone
        )



        self.start_browser()



        self.login.open()



        self.page.wait_for_timeout(
            1000
        )


        self.login.click_login()



        self.page.wait_for_timeout(
            1000
        )


        self.login.enter_phone(
            phone
        )


        self.login.submit_phone()



        print(
            "[BALE] OTP requested."
        )


        return True




    # =====================================================
    # VERIFY OTP
    # =====================================================


    def verify_otp(
        self,
        otp: str
    ):


        otp = otp.strip()


        if not otp:

            raise ValueError(
                "OTP empty"
            )



        if self.login is None:

            raise RuntimeError(
                "Login not initialized"
            )



        print(
            "[BALE] Enter OTP"
        )


        self.login.enter_otp(
            otp
        )


        self.login.submit_otp()



        self.page.wait_for_timeout(
            3000
        )



        self.bale = BalePage(
            self.page
        )



        result = (
            self.is_authenticated()
        )



        print(
            "[BALE] AUTH RESULT:",
            result
        )



        return result
